<mujoco model="go2 scene">
  <include file="go2_mjx.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <!-- Visual styling (asset, visual, lights) copied from bruce/model/flat_scene_westwood.xml. -->
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1"
      markrgb="0 0 0" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="140" elevation="-20" offwidth="3840" offheight="2560" orthographic="true"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <worldbody>
    <!-- TODO: add named cameras (e.g. side_fixed, side_fixed_forward, up_close as in Bruce), placed for Go2's height. -->
    <light pos="2 -0.5 10"  dir="-2 0 -15" directional="false" diffuse=".4 .4 .4" ambient=".3 .3 .3" specular="1 1 1"/>
    <light pos="3 0 6"  dir="-0 0 -15" directional="false" diffuse=".4 .4 .4" ambient=".2 .2 .2" specular="1 1 1"/>
    <light pos="4 4 6"  dir="-0 0 -15" directional="false" diffuse=".4 .4 .4" ambient=".2 .2 .2" specular="1 1 1"/>
    <light pos="0 4 6"  dir="-0 0 -15" directional="false" diffuse=".4 .4 .4" ambient=".2 .2 .2" specular="1 1 1"/>
    <light pos="-3 4 6"  dir="-0 0 -15" directional="false" diffuse=".4 .4 .4" ambient=".2 .2 .2" specular="1 1 1"/>
    <light pos="-6 1 6"  dir="-0 0 -15" directional="false" diffuse=".4 .4 .4" ambient=".2 .2 .2" specular="1 1 1"/>
    <light pos="7.5 3 8"  dir="-0 0 -15" directional="false" diffuse=".4 .4 .4" ambient=".2 .2 .2" specular="1 1 1"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>

  <!-- Sim-only sensors (not on the real robot). Use only in rewards or privileged obs, never in the policy obs. -->
  <!-- TODO: add foot touch sensors. Options: `contact` sensor per foot geom, or `touch` on new larger foot sites. -->
  <sensor>
    <velocimeter site="imu" name="local_linvel"/>
    <framepos objtype="site" objname="FL_foot" name="FL_foot_global_pos"/>
    <framepos objtype="site" objname="FR_foot" name="FR_foot_global_pos"/>
    <framepos objtype="site" objname="RL_foot" name="RL_foot_global_pos"/>
    <framepos objtype="site" objname="RR_foot" name="RR_foot_global_pos"/>
    <framelinvel objtype="site" objname="FL_foot" name="FL_foot_global_linvel"/>
    <framelinvel objtype="site" objname="FR_foot" name="FR_foot_global_linvel"/>
    <framelinvel objtype="site" objname="RL_foot" name="RL_foot_global_linvel"/>
    <framelinvel objtype="site" objname="RR_foot" name="RR_foot_global_linvel"/>
  </sensor>
</mujoco>
